---
import { posts } from "../data/blog.js";
---
<section class="section blog-showcase" id="blog">
  <div class="eyebrow">07 — Journal</div>
  <div class="blog-head">
    <div>
      <h2 class="blog-title">Notes from<br><em>building AI.</em></h2>
    </div>
    <div class="blog-lead">
      Short technical field notes on machine learning systems, deployment, privacy, performance, and the engineering decisions behind the work.
    </div>
  </div>

  <div class="blog-grid">
    {posts.map((post) => (
      <article class="blog-card">
        <div class="blog-meta">
          <span class="blog-kicker">{post.kicker}</span>
          <span class="blog-read">{post.readTime}</span>
        </div>
        <h3>{post.title}</h3>
        <p class="blog-excerpt">{post.excerpt}</p>
        <div class="blog-card-bottom">
          <div class="blog-tags">
            {post.tags.slice(0, 2).map((tag) => <span class="blog-tag">{tag}</span>)}
          </div>
          <a class="blog-read-link" href={"/blog/" + post.slug}>READ NOTE ↗</a>
        </div>
      </article>
    ))}
  </div>

  <div class="blog-more">
    <span>FIELD NOTES / RESEARCH LOG / ENGINEERING</span>
    <a href="/blog">OPEN JOURNAL ↗</a>
  </div>
</section>
