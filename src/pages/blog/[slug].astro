---
import Layout from "../../layouts/Layout.astro";
import { posts, getPostBySlug } from "../../data/blog.js";

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
---
<Layout>
  <div class="noise"></div>
  <main class="article-page">
    <div class="article-top">
      <span>{post.kicker}</span>
      <span>{post.readTime}</span>
    </div>

    <h1>{post.title}</h1>
    <p class="article-deck">{post.excerpt}</p>

    <div class="article-body">
      {post.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="article-tags">
      {post.tags.map((tag) => <span class="article-tag">{tag}</span>)}
    </div>

    <div class="article-cta">
      <p>More work, source code, and ongoing experiments live on GitHub.</p>
      <a href="https://github.com/mehrabJA" target="_blank" rel="noopener noreferrer">OPEN GITHUB ↗</a>
    </div>

    <a class="blog-back" href="/blog">← BACK TO JOURNAL</a>
  </main>
</Layout>
