---
import Layout from "../../layouts/Layout.astro";
import { posts } from "../../data/blog.js";
---
<Layout>
  <div class="noise"></div>
  <main class="blog-page">
    <div class="page-kicker">07 — Journal / Field Notes</div>
    <h1>Notes from <em>the work.</em></h1>
    <p class="blog-page-intro">
      A small technical journal around machine learning systems, privacy, deployment, performance engineering, and the gap between research ideas and working software.
    </p>

    <div class="blog-page-list">
      {posts.map((post, index) => (
        <article class="blog-page-card">
          <div class="num">{String(index + 1).padStart(2, "0")} / {post.kicker}</div>
          <div>
            <a href={"/blog/" + post.slug}>
              <h2>{post.title}</h2>
            </a>
            <p>{post.excerpt}</p>
          </div>
          <div class="read-time">{post.readTime}</div>
        </article>
      ))}
    </div>

    <a class="blog-back" href="/">← BACK TO PORTFOLIO</a>
  </main>
</Layout>
